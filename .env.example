# Database (sesuai docker-compose.yml). Di server, ganti password "postgres" dengan yang kuat
# dan isi juga POSTGRES_PASSWORD dengan nilai yang sama sebelum container pertama kali dibuat.
POSTGRES_PASSWORD="postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/posfnb?schema=public"

# Better Auth — WAJIB diganti dengan string acak panjang (mis. `openssl rand -base64 32`).
# Di produksi server menolak menyala jika nilai ini masih contoh.
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"

# URL aplikasi (dipakai untuk link QR & callback Midtrans).
# Agar QR bisa discan dari HP di jaringan yang sama, isi dengan IP laptop, mis. http://192.168.1.10:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Zona waktu bisnis (untuk nomor antrean & laporan harian)
APP_TIMEZONE="Asia/Jakarta"

# Midtrans Sandbox (gratis): https://dashboard.sandbox.midtrans.com → Settings → Access Keys
# Lebih mudah: isi dari Dashboard → Pengaturan (disimpan terenkripsi, menimpa nilai di bawah).
# Kosongkan di sini & di Pengaturan untuk memakai MODE DEMO (simulasi pembayaran tanpa Midtrans).
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Mode demo (simulasi bayar) otomatis MATI di produksi (NODE_ENV=production) bila key Midtrans kosong.
# Isi "true" HANYA untuk server demo yang tidak menerima uang sungguhan.
ALLOW_DEMO_PAYMENT="false"

# Login Google (opsional, gratis) — lihat README bagian "Login dengan Google".
# Lebih mudah: isi dari Dashboard → Pengaturan (menimpa nilai di bawah).
# Pelanggan bisa daftar sendiri (peran Pelanggan); staf hanya email yang didaftarkan owner.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
