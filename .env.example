# Database (sesuai docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/posfnb?schema=public"

# Better Auth — ganti secret dengan string acak panjang (mis. `openssl rand -base64 32`)
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"

# URL aplikasi (dipakai untuk link QR & callback Midtrans).
# Agar QR bisa discan dari HP di jaringan yang sama, isi dengan IP laptop, mis. http://192.168.1.10:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Zona waktu bisnis (untuk nomor antrean & laporan harian)
APP_TIMEZONE="Asia/Jakarta"

# Midtrans Sandbox (gratis): https://dashboard.sandbox.midtrans.com → Settings → Access Keys
# Kosongkan keduanya untuk memakai MODE DEMO (simulasi pembayaran tanpa Midtrans).
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Login Google (opsional, gratis) — lihat README bagian "Login dengan Google".
# Kosongkan keduanya untuk menyembunyikan tombol "Masuk dengan Google".
# Hanya email staf yang sudah didaftarkan owner yang bisa masuk lewat Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
